# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188

# App
APP_HOST=127.0.0.1
APP_PORT=8787
MOCK_MODE=true
DEFAULT_ASPECT=16:9
SUBTITLES_DEFAULT=true

# Projects root (leave empty to auto: D:\mv-studio\projects or ~/mv-studio/projects)
PROJECTS_ROOT=

# Optional local token (empty = disabled)
LOCAL_TOKEN=

# Workflows (relative to repo root)
MUSIC_WORKFLOW_PATH=app/workflows/minimax_music3_api.json
IMAGE_WORKFLOW_PATH=app/workflows/txt2img_api.json

# Image defaults
IMAGE_CHECKPOINT=sd_xl_base_1.0.safetensors
IMAGE_SEED=42
IMAGE_STEPS=20
IMAGE_CFG=7.0
IMAGE_WIDTH_16_9=1920
IMAGE_HEIGHT_16_9=1080
IMAGE_WIDTH_9_16=1080
IMAGE_HEIGHT_9_16=1920

# Timeline / ffmpeg
MIN_SHOT_DURATION_SEC=2.0
SUBTITLE_FONT=Microsoft YaHei
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Timeouts (seconds)
COMFYUI_TIMEOUT_SEC=600
DEEPSEEK_TIMEOUT_SEC=120
